# ============================================================================
# Database (Neon / Postgres)
# ============================================================================
# Use the pooled connection string from your Neon project dashboard.
DATABASE_URL=postgresql://user:password@ep-xxxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# ============================================================================
# App / Site
# ============================================================================
# Do NOT set NODE_ENV here — Next.js sets it automatically based on
# whether you run `next dev` or `next build && next start`, and manually
# forcing it to "production" during local dev breaks login (session
# cookies get marked Secure and the browser silently refuses to store them
# over plain http://localhost). Just leave this line out entirely.
SITE_URL=https://juru.lol
SITE_NAME=Juru

# ============================================================================
# Sessions & crypto
# ============================================================================
# 64+ char random hex strings. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace_with_a_generated_64_char_random_string
HWID_HASH_PEPPER=replace_with_a_different_generated_random_string
# Used to encrypt license keys at rest so admins/owners can look up a
# customer's actual key (support requests, "I lost my key", etc.) without
# storing raw plaintext. Losing this value permanently loses the ability to
# decrypt existing keys — back it up somewhere safe, separate from the
# database itself.
KEY_ENCRYPTION_SECRET=replace_with_a_third_different_generated_random_string

# ============================================================================
# Stripe (payments)
# ============================================================================
# From https://dashboard.stripe.com/apikeys and /webhooks
STRIPE_SECRET_KEY=sk_live_or_sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Public key is safe to expose to the browser (Next.js NEXT_PUBLIC_ convention)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_or_pk_test_xxx

# ============================================================================
# NOWPayments (crypto payments)
# ============================================================================
# Sign up at nowpayments.io, generate an API key, and set an IPN Secret Key
# in Store Settings — the IPN secret is what verifies webhook authenticity,
# separate from the API key used to create payments.
NOWPAYMENTS_API_KEY=your_api_key
NOWPAYMENTS_IPN_SECRET=your_ipn_secret
# Set this as your callback URL when creating payments (already wired
# automatically by the checkout code): https://emblem.gg/api/webhooks/nowpayments

# ============================================================================
# Discord
# ============================================================================
# Where /discord redirects to. Also editable at runtime from the admin
# dashboard (stored in the `configuration` table) — this is just the
# fallback used before an admin sets one.
DISCORD_INVITE_URL=https://discord.gg/your-invite

# ============================================================================
# VPN / proxy detection (visitor log)
# ============================================================================
# Optional. Powers the "VPN" badge on /dashboard/admin/visitors and the
# real-IP-over-VPN override on users.last_ip. Uses getipintel.net, which is
# free and needs no signup or API key — but their terms require a real
# contact email on every request, and are strict about it (queries without
# one are rejected). Use an email you actually check; they may email you
# if there's an issue with your usage.
#
# Free tier is rate-limited (15/min, ~500/day) with no paid tier to
# upgrade to, so this app only checks each IP once, and only calls this
# inline (not in the background) from login/register, never from the
# script's own auth handshake, which fires far more often.
#
# Leave this unset to disable VPN detection entirely — every other part of
# the visitor log and IP banning system works fine without it.
VPN_CHECK_CONTACT_EMAIL=you@example.com

# ============================================================================
# First admin bootstrap
# ============================================================================
# On first migrate, if no admin exists yet, a user with this email (if
# already registered) is promoted to admin. Otherwise promote manually:
#   UPDATE users SET role = 'admin' WHERE email = 'you@example.com';
INITIAL_ADMIN_EMAIL=you@example.com

# ============================================================================
# Rate limiting / misc
# ============================================================================
TRUST_PROXY=1
